{
	"luci-app-samba4": {
		"description": "Grant access to LuCI app samba4",
		"read": {
			"file": {
				"/": [ "list", "read", "stat" ],
				"/etc/samba/smb.conf.template": [ "read" ],
			"/usr/sbin/smbd -V": [ "exec" ],
			"/etc/init.d/samba4 reload": [ "exec" ],
			"/etc/init.d/samba4 restart": [ "exec" ],
			"/etc/init.d/wsdd2 enable": [ "exec" ],
			"/etc/init.d/wsdd2 disable": [ "exec" ],
			"/etc/init.d/wsdd2 restart": [ "exec" ],
			"/etc/init.d/wsdd2 start": [ "exec" ],
			"/usr/bin/wsdd2": [ "exec" ],
			"/bin/mkdir": [ "exec" ],
			"/usr/libexec/smb-usermgr.sh": [ "exec" ]
			},
			"uci": [ "samba4" ]
		},
		"write": {
			"file": {
				"/etc/samba/smb.conf.template": [ "write" ]
			},
			"uci": [ "samba4" ]
		}
	}
}
